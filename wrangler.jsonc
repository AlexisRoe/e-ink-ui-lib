{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "e-ink-ui-lib",
  "compatibility_date": "2026-05-15",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./storybook-static",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true
}
